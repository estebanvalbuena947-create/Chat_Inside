    {
      "parameters": {
        "jsCode": "const task=$('Entrada de un seguimiento').first().json;\nconst raw=$input.first().json || {};\nlet body=raw.body ?? raw;\nif(typeof body==='string'){try{body=JSON.parse(body);}catch{body={};}}\nconst status=raw.statusCode==null?200:Number(raw.statusCode);\nconst fail=(motivo,estado='revision')=>[{json:{...task,contacto_valido:false,estado_final:estado,detalle:{motivo}}}];\nif(raw.error || status<200 || status>=300 || body.status!=='success') return fail('MANYCHAT_CONTACTO_NO_VERIFICADO');\nconst c=body.data || {};\nif(String(c.id)!==String(task.subscriber_id)) return fail('MANYCHAT_CONTACTO_NO_COINCIDE');\nif(c.status!=='active' || c.is_followup_enabled===false) return fail('CONTACTO_INACTIVO_O_SEGUIMIENTO_DESHABILITADO','cancelado');\nconst channel=task.payload?.canal;\nif(channel==='tiktok' && !c.tt_user_id) return fail('CONTACTO_SIN_TIKTOK');\nif(channel==='instagram' && !c.ig_id) return fail('CONTACTO_SIN_INSTAGRAM');\nif(!['instagram','tiktok'].includes(channel)) return fail('CANAL_NO_CONFIGURADO');\nconst clean=s=>String(s||'').replace(/\\s+/g,' ').trim();\nif(clean(c.last_input_text) && clean(task.payload?.ultimo_mensaje_cliente) && clean(c.last_input_text)!==clean(task.payload.ultimo_mensaje_cliente)) return fail('CLIENTE_YA_RESPONDIO','cancelado');\nreturn [{json:{...task,contacto_valido:true}}];\n"
      },
