# El worker usa estas credenciales exclusivamente en el servidor.
# Copia los mismos valores privados de apps/api/.env para el entorno local.
SUPABASE_URL=https://jidefunczooxxppqmkra.supabase.co
SUPABASE_SECRET_KEY=

# Aviso al agente cuando el cliente pulsa un boton de una plantilla aprobada.
# Sin las dos variables el toque se guarda en la bandeja y no se avisa a nadie: se registra el
# motivo y ese aviso no se recupera despues, asi que conviene configurarlas antes de usar plantillas.
N8N_AGENT_WEBHOOK_URL=
N8N_AGENT_AUTH_SECRET=
